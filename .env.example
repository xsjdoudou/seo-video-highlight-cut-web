# 环境变量模板。这个文件跟着仓库走，所以只能放空值和示例值。
#
#   cp .env.example .env
#   chmod 600 .env          # 真实令牌，别让同机器的其他用户读到
#   vi .env
#
# .env 已经在 .gitignore 里，不会被提交。
#
# 两条规则：
#
# 1. 变量名一律不要加 VITE_ 前缀。vite 的 envPrefix 默认是 VITE_，带这个前缀的
#    值会被直接编译进浏览器能下载到的 JS 文件里——令牌就等于公开了。
# 2. 已经存在的环境变量优先于这个文件（和 node --env-file 的行为一致）。
#    临时覆盖一下用 `SEO_TOKEN=xxx npm run dev`，不用改文件。

# ── 生产中继：AWS 网站 ← HTTPS 长轮询 ← 阿里云 Worker ─────────────────────
# AWS 不直连阿里云 10080，也不依赖 SSH 反向隧道。阿里云 Worker 通过 gg 主动连回
# 这个站点，领取任务后访问它本机的 http://127.0.0.1:10080。
# 生成一个高熵令牌，填到 AWS 和阿里云 worker.env 的 WORKER_TOKEN：
#   openssl rand -hex 32
WORKER_TOKEN=
WORKER_POLL_MAX_WAIT_MS=25000
WORKER_LEASE_MS=90000
RELAY_JOB_RETENTION_MS=604800000

# 旧的 SEO_URL / SEO_TOKEN 仅供本地 direct 模式代码和历史排障使用，生产 clip-api
# 不会通过它访问阿里云。不要把阿里云 10080 写进 AWS 的生产配置。
SEO_URL=
SEO_TOKEN=

# 给**浏览器**用的地址前缀：上传回执、成片播放/下载链接都拿它来拼。
# 不是给国内剪辑服务用的——浏览器上传仍由 AWS clip-api 接收，成片链接拿它来拼。
# 本机联调留空即可（默认 http://127.0.0.1:10050）。
# 海外部署填终端用户能访问到的地址，例如 https://your-domain.com
PUBLIC_BASE=

# 阿里云下载 AWS 本地上传源视频时使用的地址前缀。
# 必须是阿里云能直接 GET 的公网地址，不能是 127.0.0.1，也不能只经过需要
# Basic Auth 的页面代理。没有单独的源视频域名时可以和 PUBLIC_BASE 相同。
SOURCE_PUBLIC_BASE=

# ── OSS：只由阿里云后端上传成片，AWS 不再上传源视频 ───────────────────────
# OSS_URL_MODE=signed 时不需要 CDN 权限，也不需要把桶设置成公共读；脚本会返回
# 一个临时签名 URL。signed_url_expires 要覆盖排队和处理前的下载时间。
# 部署完先跑：
#   python3 scripts/oss_upload.py --check
OSS_AK=
OSS_SK=

# 必须用公网接入点 oss-cn-*.aliyuncs.com。
# Nacos 里那套配的是 oss-cn-shanghai-internal.aliyuncs.com，带 -internal 的
# 只在阿里云 VPC 内部可达，海外机器连不上，而且报错是超时，看不出原因。
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=

# signed 是推荐模式；只有已经有 CDN 域名时才改成 cdn。
OSS_URL_MODE=signed
OSS_SIGNED_URL_EXPIRES=21600

# 仅 OSS_URL_MODE=cdn 时需要，例如 https://cdn.example.com
OSS_CDN_URL=

# 对象名前缀，留空用脚本里的默认值
OSS_PREFIX=

# 跑上传脚本的解释器，默认 python3
OSS_PYTHON=

# ── 本机服务 ──────────────────────────────────────────────────────────────
# clip-api 独立模式的监听端口（npm run preview 这套用）。dev 模式不用，
# dev 下 clip-api 是挂在 vite 进程里的。
CLIP_API_PORT=10051

# auth-proxy 的 Basic 认证。留空的话 AUTH_PASS 每次启动随机生成并打在日志里。
AUTH_USER=
AUTH_PASS=
