# 环境变量模板。这个文件跟着仓库走，所以只能放空值和示例值。
#
#   cp .env.example .env
#   chmod 600 .env          # 真实令牌，别让同机器的其他用户读到
#   vi .env
#
# .env 已经在 .gitignore 里，不会被提交。
#
# 两条规则：
#
# 1. 变量名一律不要加 VITE_ 前缀。vite 的 envPrefix 默认是 VITE_，带这个前缀的
#    值会被直接编译进浏览器能下载到的 JS 文件里——令牌就等于公开了。
# 2. 已经存在的环境变量优先于这个文件（和 node --env-file 的行为一致）。
#    临时覆盖一下用 `SEO_TOKEN=xxx npm run dev`，不用改文件。

# ── 剪辑服务：国内那台 GPU 机器上的 seo_server.py ─────────────────────────
# 必须是完整 URL，带协议和端口。只写 IP（101.132.167.193）会让 new URL() 直接抛错。
#
# 默认走 SSH 反向隧道，所以这里填的是 127.0.0.1——隧道那头才是国内的服务。
# 为什么不直连 EIP：那台 ECS（i-uf659g4jleurwg5zoboz，cn-shanghai，
# EIP 101.132.167.193）的安全组入方向规则我们没权限改，直连是超时。
# 隧道怎么配见 README「连不上又改不了安全组」。
SEO_URL=http://127.0.0.1:10080
#
# 真有人帮你在安全组里加了入方向规则的话，换成直连也行，改这一行就够了：
#   SEO_URL=http://101.132.167.193:10080
# 注意直连是明文 HTTP，令牌会明文过公网；隧道是 SSH 加密的。
#
# 两头的端口不一样，由隧道对上：海外这头是 10080，国内那头是 seo_server.py
# 自己的默认值 8649（`-R 127.0.0.1:10080:127.0.0.1:8649`）。
# 所以国内永远是 `python seo_server.py` 裸跑，不用带 SEO_PORT=。

# 访问令牌，必须和国内那台机器上 seo_server.py 进程里的 SEO_TOKEN 一模一样。
# 生成：openssl rand -hex 32
# 留空 = 不带令牌发请求。只有服务端也没配 SEO_TOKEN 时才行；服务端配了而这里留空，
# 第一次提交任务就会返回 401 并直接报错（不会重试，重试一百次也是同一个结果）。
SEO_TOKEN=

# 给**浏览器**用的地址前缀：上传回执、成片播放/下载链接都拿它来拼。
# 不是给国内剪辑服务用的——交给下游的 video_url 永远是 OSS 地址（见 clip-api.mjs
# 里 uploadToOss 上面那段注释），国内那台根本不读这个变量。
# 本机联调留空即可（默认 http://127.0.0.1:10050）。
# 海外部署填终端用户能访问到的地址，例如 https://your-domain.com
PUBLIC_BASE=

# ── OSS：上传源视频，换一个公网可下载的 URL 给剪辑服务 ────────────────────
# 这五个必须设齐。缺任何一个都会退回去读内网 Nacos，而海外机器连不上内网 Nacos，
# 于是每个任务都会在上传这一步失败。部署完先跑：
#   python3 scripts/oss_upload.py --check
OSS_AK=
OSS_SK=

# 必须用公网接入点 oss-cn-*.aliyuncs.com。
# Nacos 里那套配的是 oss-cn-shanghai-internal.aliyuncs.com，带 -internal 的
# 只在阿里云 VPC 内部可达，海外机器连不上，而且报错是超时，看不出原因。
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=

# 拼返回 URL 用的 CDN 域名，例如 https://cdn.example.com
OSS_CDN_URL=

# 对象名前缀，留空用脚本里的默认值
OSS_PREFIX=

# 跑上传脚本的解释器，默认 python3
OSS_PYTHON=

# ── 本机服务 ──────────────────────────────────────────────────────────────
# clip-api 独立模式的监听端口（npm run preview 这套用）。dev 模式不用，
# dev 下 clip-api 是挂在 vite 进程里的。
CLIP_API_PORT=10051

# auth-proxy 的 Basic 认证。留空的话 AUTH_PASS 每次启动随机生成并打在日志里。
AUTH_USER=
AUTH_PASS=
